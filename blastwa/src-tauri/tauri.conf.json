{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlastWA",
  "version": "0.2.0",
  "identifier": "com.blastwa.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "BlastWA — WhatsApp Bulk Sender",
